# ────────────────────────────────────────────────────────
#  Taska — Mobile Environment Variables
# ────────────────────────────────────────────────────────
# Prefix with EXPO_PUBLIC_ to make them available at runtime.
# These are injected via eas.json build profiles or .env files.

EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
EXPO_PUBLIC_ENV=development
