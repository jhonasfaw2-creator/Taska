# ────────────────────────────────────────────────────────
#  Taska — Backend Environment Variables
# ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For production, generate secure secrets:
#   openssl rand -hex 32   # for JWT_SECRET and JWT_REFRESH_SECRET

# ─── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL) ─────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://taska_user:YOUR_PASSWORD@localhost:5432/taska_db

# ─── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Logging ────────────────────────────────────────────
# Morgan log format: combined | dev | common | short | tiny
# Use "combined" in production for Apache-style logs
LOG_FORMAT=dev

# ─── JWT (JSON Web Tokens) ──────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=taska-dev-jwt-secret-do-not-use-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=taska-dev-jwt-refresh-secret-do-not-use-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Dev Mode ───────────────────────────────────────────
# When true, OTP codes are returned in API responses for testing
DEV_MODE=true

# ─── Media / File Storage ──────────────────────────────
# Storage provider: local | s3
STORAGE_PROVIDER=local
# Local uploads directory (relative to project root)
UPLOADS_DIR=uploads
# Max file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760
# S3-compatible storage (only required when STORAGE_PROVIDER=s3)
S3_REGION=us-east-1
S3_BUCKET=taska-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint (e.g., MinIO, DigitalOcean Spaces)
S3_ENDPOINT=

# ════════════════════════════════════════════════════════════
#  PRODUCTION SETTINGS (override in .env.production or CI)
# ════════════════════════════════════════════════════════════

# NODE_ENV=production
# DEV_MODE=false
# LOG_FORMAT=combined
# JWT_SECRET=<openssl rand -hex 32>
# JWT_REFRESH_SECRET=<openssl rand -hex 32>
# CORS_ORIGINS=https://your-app.com
# DATABASE_URL=postgresql://user:password@host:5432/taska_prod
