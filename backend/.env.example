# ────────────────────────────────────────────────────────
#  Taska — Backend Environment Variables
# ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For first-time setup, run the database setup script:
#   sudo bash backend/scripts/setup-db.sh

# ─── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL) ─────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Create via: sudo bash backend/scripts/setup-db.sh
DATABASE_URL=postgresql://taska_user:YOUR_PASSWORD@localhost:5432/taska_db

# ─── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins
# Include your Expo dev server origin if testing on device
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Logging ────────────────────────────────────────────
# Morgan log format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# ─── JWT (JSON Web Tokens) ──────────────────────────────
# In development, built-in fallback secrets are used.
# In production, generate and set these:
#   openssl rand -hex 32
JWT_SECRET=taska-dev-jwt-secret-do-not-use-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=taska-dev-jwt-refresh-secret-do-not-use-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Dev Mode ───────────────────────────────────────────
# When true, OTP codes are returned in API responses for testing
DEV_MODE=true
